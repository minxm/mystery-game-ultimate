# 硅基流动 SiliconFlow（国内直连，无需代理）
# 注册地址：https://cloud.siliconflow.cn
# 实名认证后可免费使用 Qwen3、DeepSeek-R1 等模型
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# 可选：自定义 API 地址和模型
# AI_BASE_URL=https://api.siliconflow.cn/v1
# 案件生成推荐 THUDM/GLM-4-9B-0414（免费、结构化 JSON 更稳、剧情质量较好）。
# 审讯对话默认 Qwen/Qwen2.5-7B-Instruct；备选免费：Qwen/Qwen2.5-7B-Instruct。
# AI_TEXT_MODEL=THUDM/GLM-4-9B-0414
# AI_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
# AI_IMAGE_MODEL=Kwai-Kolors/Kolors

# AI 生图：默认开启（本地与 Netlify 均生成 Kolors AI 图）；设为 false 则仅用 SVG 占位图
# AI_GENERATE_IMAGES=false

# 可选：案件生成超时（毫秒），Netlify 默认 50000
# AI_CASE_TIMEOUT_MS=50000
