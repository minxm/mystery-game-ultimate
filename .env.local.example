# 硅基流动 SiliconFlow（国内直连，无需代理）
# 注册地址：https://cloud.siliconflow.cn
# 实名认证后可免费使用 Qwen3、DeepSeek-R1 等模型
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# 可选：自定义 API 地址和模型
# AI_BASE_URL=https://api.siliconflow.cn/v1
# AI_TEXT_MODEL=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B
# AI_CHAT_MODEL=Qwen/Qwen3-8B
# AI_IMAGE_MODEL=Kwai-Kolors/Kolors

# 本地开发可开启 AI 生图（线上 Netlify 默认关闭，避免超时 502）
# AI_GENERATE_IMAGES=true
# AI_TEXT_MODEL=deepseek-ai/DeepSeek-V3
# AI_CHAT_MODEL=deepseek-ai/DeepSeek-V3

# 可选：案件生成超时（毫秒），Netlify 默认 50000
# AI_CASE_TIMEOUT_MS=50000
