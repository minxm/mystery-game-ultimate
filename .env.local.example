# 硅基流动 SiliconFlow（国内直连，无需代理）
# 注册地址：https://cloud.siliconflow.cn
# 实名认证后可免费使用 Qwen3、DeepSeek-R1 等模型
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# 可选：自定义 API 地址和模型（多模型分工）
# AI_BASE_URL=https://api.siliconflow.cn/v1
# AI_CASE_FRAMEWORK_MODEL=Qwen/Qwen3.5-4B  # 案件框架（快速骨架）
# AI_CASE_POLISH_MODEL=Qwen/Qwen3-8B       # 案件润色（叙事增强）
# AI_CASE_MODEL=Qwen/Qwen3-8B              # 兼容旧变量，等同 AI_CASE_POLISH_MODEL
# AI_CHAT_MODEL=THUDM/GLM-4-9B-0414       # 嫌疑人角色扮演对话
# AI_EVALUATE_MODEL=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B  # 推理评分
# AI_IMAGE_PROMPT_MODEL=Qwen/Qwen3-8B      # 图片 Prompt 生成（与案件 JSON 对齐）
# AI_IMAGE_MODEL=Kwai-Kolors/Kolors        # 受害者/嫌疑人/现场配图
# AI_EMBEDDING_MODEL=BAAI/bge-m3           # 案件知识库向量检索（审讯 RAG）

# AI 生图：默认开启；设为 false 则仅用 SVG 占位图
# AI_GENERATE_IMAGES=false

# 可选：案件生成超时（毫秒）
# AI_CASE_TIMEOUT_MS=50000
# AI_LOCAL_TIMEOUT_MS=360000
# AI_PHASE_TIMEOUT_MS=120000
# AI_JSON_CLIENT_TIMEOUT_MS=150000
